COMPOSE_PROJECT_NAME=quality-watch
FRONTEND_PORT=18216
BACKEND_PORT=19216
DB_PORT=17716
DB_PASSWORD=study_demo_password
JWT_SECRET=quality-watch-demo-change-this-before-public-use
SEED_DEMO=true
# 运行心跳超过 RUN_STALE_SECONDS 未更新即判定计算进程中断，worker 自动恢复重投
RUN_STALE_SECONDS=60
HEARTBEAT_INTERVAL=10
RECOVERY_INTERVAL=15
